DATABASE_URL=

ORIGIN="http://localhost:5173"

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=

# Email (password reset). Any SMTP provider works. If SMTP_HOST is empty the
# email is printed to the server console instead of being sent.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM=

# Cloudflare R2 (S3-compatible)
# Create an API token with R2 read/write scope in the Cloudflare dashboard
R2_TOKEN=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
R2_BUCKET_NAME=""
